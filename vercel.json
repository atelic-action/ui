{
	"installCommand": "bun install",
	"buildCommand": "bun run storybook:build",
	"outputDirectory": "storybook-static",
	"framework": null,
	"cleanUrls": false,
	"redirects": [
		{ "source": "/app", "destination": "/?path=/docs/app-applayout--docs", "permanent": false },
		{ "source": "/app.html", "destination": "/?path=/docs/app-applayout--docs", "permanent": false }
	]
}
