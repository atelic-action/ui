{
	"name": "@atelic-action/ui",
	"version": "3.0.0",
	"description": "Shared UI for the Atelic templates: site chrome, base styles, the component library, the access gate, and the app shell they install",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atelic-action/ui.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"dist",
		"bin"
	],
	"bin": {
		"atelic-check-access": "./bin/atelic-check-access.ts",
		"atelic-check-base-path": "./bin/atelic-check-base-path.ts",
		"atelic-check-links": "./bin/atelic-check-links.ts",
		"atelic-check-wall": "./bin/atelic-check-wall.ts",
		"atelic-clean-sitemap": "./bin/atelic-clean-sitemap.ts",
		"atelic-contact-canary": "./bin/atelic-contact-canary.ts",
		"atelic-print-sheets": "./bin/atelic-print-sheets.sh",
		"atelic-reader-link": "./bin/atelic-reader-link.ts",
		"atelic-seal-document": "./bin/atelic-seal-document.mjs",
		"atelic-serve-static": "./bin/atelic-serve-static.ts",
		"atelic-stamp-health": "./bin/atelic-stamp-health.ts"
	},
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./app": "./src/app/index.ts",
		"./app/ui": "./src/app/ui/index.ts",
		"./artifact": "./src/artifact/index.ts",
		"./artifact/readers": {
			"types": "./dist/artifact/readers.d.ts",
			"default": "./dist/artifact/readers.js"
		},
		"./chrome": "./src/chrome/index.ts",
		"./components": "./src/components/index.ts",
		"./email": "./src/email/index.ts",
		"./email/render": "./src/email/render.tsx",
		"./hooks": "./src/hooks/index.ts",
		"./primitives": "./src/primitives/index.ts",
		"./routing": "./src/routing/index.ts",
		"./routing/base-path": {
			"types": "./dist/routing/basePath.d.ts",
			"default": "./dist/routing/basePath.js"
		},
		"./sections": "./src/sections/index.ts",
		"./tokens": "./src/tokens/index.ts",
		"./styles/app.css": "./src/styles/app.css",
		"./styles/artifact.css": "./src/styles/artifact.css",
		"./styles/base.css": "./src/styles/base.css",
		"./styles/chrome.css": "./src/styles/chrome.css",
		"./styles/components.css": "./src/styles/components.css",
		"./styles/gate.css": "./src/styles/gate.css",
		"./styles/primitives.css": "./src/styles/primitives.css",
		"./styles/sections.css": "./src/styles/sections.css",
		"./styles/star-rating.css": "./src/styles/star-rating.css",
		"./gate": {
			"types": "./dist/gate/index.d.ts",
			"default": "./dist/gate/index.js"
		},
		"./gate/middleware": {
			"types": "./dist/gate/middleware.d.ts",
			"default": "./dist/gate/middleware.js"
		},
		"./gate/request-link": {
			"types": "./dist/gate/request-link.d.ts",
			"default": "./dist/gate/request-link.js"
		},
		"./gate/verify": {
			"types": "./dist/gate/verify.d.ts",
			"default": "./dist/gate/verify.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./vite/private-chunks": {
			"types": "./dist/vite/private-chunks.d.ts",
			"default": "./dist/vite/private-chunks.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.server.json",
		"build:smoke": "node --input-type=module -e \"for (const entry of ['gate', 'gate/middleware', 'gate/request-link', 'gate/verify', 'vite', 'vite/private-chunks', 'artifact/readers', 'routing/base-path']) await import('@atelic-action/ui/' + entry)\"",
		"prepack": "bun run build",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p gallery",
		"test:run": "vitest run",
		"gallery:dev": "vite gallery",
		"gallery:build": "vite build gallery"
	},
	"dependencies": {
		"jose": "^6.2.12",
		"qrcode": "^1.5.4"
	},
