		"react-dom": "^19.0.0",
		"react-hook-form": "^7.71.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.0.0",
		"tailwindcss": "^4.1.17",
		"vite": "^7.0.0 || ^8.0.0",
		"zod": "^4.3.5",
		"zustand": "^5.0.1"
	},
