{
	"name": "@atelic-action/ui",
	"version": "0.9.0",
	"description": "Shared UI for the Atelic templates: site chrome, base styles, and the component library they install",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atelic-action/ui.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./chrome": "./src/chrome/index.ts",
		"./components": "./src/components/index.ts",
		"./email": "./src/email/index.ts",
		"./email/render": "./src/email/render.tsx",
		"./hooks": "./src/hooks/index.ts",
		"./routing": "./src/routing/index.ts",
		"./tokens": "./src/tokens/index.ts",
		"./styles/base.css": "./src/styles/base.css",
		"./styles/chrome.css": "./src/styles/chrome.css",
		"./styles/components.css": "./src/styles/components.css",
		"./styles/star-rating.css": "./src/styles/star-rating.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "tsc --noEmit && tsc --noEmit -p gallery",
		"test:run": "vitest run",
		"gallery:dev": "vite gallery",
		"gallery:build": "vite build gallery"
	},
	"peerDependencies": {
		"lucide-react": "^1.23.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@testing-library/jest-dom": "^6.6.2",
		"@testing-library/react": "^16.0.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^25.0.1",
		"lucide-react": "^1.23.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.6.3",
		"vite": "^8.3.2",
		"vitest": "^4.0.0"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	]
}
