{
	"name": "@atelic-action/ui",
	"version": "0.1.0",
	"description": "Shared UI for the Atelic templates: site chrome, base styles, and the component library they install",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atelic-action/ui.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./chrome": "./src/chrome/index.ts",
		"./hooks": "./src/hooks/index.ts",
		"./styles/base.css": "./src/styles/base.css",
		"./styles/chrome.css": "./src/styles/chrome.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "tsc --noEmit",
		"test:run": "vitest run"
	},
	"peerDependencies": {
		"lucide-react": "^1.23.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@testing-library/jest-dom": "^6.6.2",
		"@testing-library/react": "^16.0.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"jsdom": "^25.0.1",
		"lucide-react": "^1.23.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.6.3",
		"vitest": "^4.0.0"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	]
}
