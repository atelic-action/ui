{
	"name": "@atelic-action/ui",
	"version": "0.15.1",
	"description": "Shared UI for the Atelic templates: site chrome, base styles, the component library, and the access gate they install",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atelic-action/ui.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./artifact": "./src/artifact/index.ts",
		"./artifact/readers": {
			"types": "./dist/artifact/readers.d.ts",
			"default": "./dist/artifact/readers.js"
		},
		"./chrome": "./src/chrome/index.ts",
		"./components": "./src/components/index.ts",
		"./email": "./src/email/index.ts",
		"./email/render": "./src/email/render.tsx",
		"./hooks": "./src/hooks/index.ts",
		"./primitives": "./src/primitives/index.ts",
		"./routing": "./src/routing/index.ts",
		"./tokens": "./src/tokens/index.ts",
		"./styles/artifact.css": "./src/styles/artifact.css",
		"./styles/base.css": "./src/styles/base.css",
		"./styles/chrome.css": "./src/styles/chrome.css",
		"./styles/components.css": "./src/styles/components.css",
		"./styles/gate.css": "./src/styles/gate.css",
		"./styles/primitives.css": "./src/styles/primitives.css",
		"./styles/star-rating.css": "./src/styles/star-rating.css",
		"./gate": {
			"types": "./dist/gate/index.d.ts",
			"default": "./dist/gate/index.js"
		},
		"./gate/middleware": {
			"types": "./dist/gate/middleware.d.ts",
			"default": "./dist/gate/middleware.js"
		},
		"./gate/request-link": {
			"types": "./dist/gate/request-link.d.ts",
			"default": "./dist/gate/request-link.js"
		},
		"./gate/verify": {
			"types": "./dist/gate/verify.d.ts",
			"default": "./dist/gate/verify.js"
		},
		"./vite": {
			"types": "./dist/vite/private-chunks.d.ts",
			"default": "./dist/vite/private-chunks.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.server.json",
		"build:smoke": "node --input-type=module -e \"for (const entry of ['gate', 'gate/middleware', 'gate/request-link', 'gate/verify', 'vite', 'artifact/readers']) await import('@atelic-action/ui/' + entry)\"",
		"prepack": "bun run build",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p gallery",
		"test:run": "vitest run",
		"gallery:dev": "vite gallery",
		"gallery:build": "vite build gallery"
	},
	"dependencies": {
		"jose": "^6.2.12"
	},
	"peerDependencies": {
		"lucide-react": "^1.23.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"vite": "^7.0.0 || ^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@testing-library/jest-dom": "^6.6.2",
		"@testing-library/react": "^16.0.1",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^25.0.1",
		"lucide-react": "^1.23.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.6.3",
		"vite": "^8.3.2",
		"vitest": "^4.0.0"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	]
}
