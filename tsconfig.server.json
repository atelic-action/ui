{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],

    /* The gate runs where nothing compiles it: Vercel executes a function's
       and a middleware's package imports as shipped, by Node's own ESM
       rules. So this one corner of the package is built, to dist/. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/gate/*.ts", "src/vite/*.ts", "src/artifact/readers.ts"]
}
